# Separate owner dashboard; monitoring is read-only, invite creation is optional.
# Existing owner key file; never paste the key into this file or commit it.
DASHBOARD_OWNER_KEY_FILE=C:\DauntlessRevived\data\keys\owner.key
DASHBOARD_BACKEND=http://127.0.0.1:61000
DASHBOARD_PORT=61110
# Optional explicit label -> absolute log filename map. Use actual paths from your install.
DASHBOARD_LOG_FILES={}
# Optional: enables owner-only invite generation for a public-mode server.
DASHBOARD_SERVER_CONFIG=C:\DauntlessRevived\data\config\server.json
# Optional: reads bounded tails of the kit's numeric performance CSVs (no extra process scanner).
DASHBOARD_PERFORMANCE_DIR=C:\DauntlessRevived\data\logs\performance
# Optional worker monitor through the private SSH connection.
# DASHBOARD_WORKER_URL=http://127.0.0.1:61112
# Optional AUS worker monitor through its private SSH connection.
# DASHBOARD_AUS_URL=http://127.0.0.1:61122
# DASHBOARD_GERMANY_URL=http://127.0.0.1:61132
