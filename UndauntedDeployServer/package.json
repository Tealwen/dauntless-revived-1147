{
  "name": "dauntless-revived-deploy-server",
  "version": "0.0.5",
  "description": "The deploy server for Dauntless Revived",
  "license": "AGPL-3.0-only",
  "author": "gwog :3",
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \"build/test/**/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.6.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "tsx": {
      "esbuild": "0.28.2"
    }
  }
}
